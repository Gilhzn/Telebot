# Copy to .env and fill in. Never commit .env.
# --- required ---
TELEGRAM_BOT_TOKEN=
# Empty = auto-detect: send /start to the bot in a private chat (or run: python bot.py --test)
TELEGRAM_CHAT_ID=
# Name + email, required by SEC fair-access rules
SEC_USER_AGENT=Your Name you@example.com

# --- optional ---
# Enables scoring with Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# false = every filing of watchlist stocks, without scoring
POSITIVE_ONLY=true
# Send threshold, -5..5
MIN_SCORE=4
# false = watchlist only
MARKETWIDE=true
# Initial watchlist, comma separated (after the first run it lives in state.json; use /add, /remove)
WATCHLIST=
CANDIDATE_ITEMS=1.01,2.01,2.02,7.01,8.01
EDGAR_FORMS=8-K,6-K
EDGAR_POLL_SECONDS=2
WIRE_POLL_SECONDS=10
WIRE_FEEDS=https://www.prnewswire.com/rss/news-releases-list.rss,https://www.globenewswire.com/RssFeed/orgclass/1/feedTitle/GlobeNewswire%20-%20News%20about%20Public%20Companies
DEDUP_HOURS=6
MAX_ALERTS_PER_CYCLE=15
STATE_FILE=state.json
